<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for p in site.html_pages %}{% unless p.noindex %}<url><loc>{{ site.url }}{{ p.url | replace: 'index.html', '' }}</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod><priority>{% if p.url == "/" %}1.0{% else %}0.7{% endif %}</priority></url>
{% endunless %}{% endfor %}</urlset>
